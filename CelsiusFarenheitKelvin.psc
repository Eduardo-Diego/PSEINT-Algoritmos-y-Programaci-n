// Algoritmo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo CelsiusFarenheitKelvin
	Definir n, K, F Como Real
	Escribir 'Ingresa los grados Celsius: '
	Leer n
	K <- n+273.15
	F <- (n*(9/5))+32
	Escribir 'Cantidad en Kelvin: ', K
	Escribir 'Cantidad en Farenheit: ', F
FinAlgoritmo
